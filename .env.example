# Realty Nest — frontend (Next.js). Skopiuj do .env.local i uzupelnij.
#
# OBOWIAZKOWE — bez nich aplikacja nie wstanie (src/instrumentation.ts przerywa start).
# AUTH_SECRET musi miec co najmniej 32 znaki. Wygeneruj:  openssl rand -base64 48
AUTH_SECRET=
GRAPHQL_INTERNAL_URL=http://localhost:4000/graphql

# OPCJONALNE — adres publiczny. Uzywany w metadanych, mapie strony i CORS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=contact@realtynest.app

# OPCJONALNE — Cloudinary. Bez tych kluczy wysylka plikow, podglad dokumentow
# i kopie zapasowe zwracaja 503; reszta systemu dziala normalnie.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=realty-nest

# OPCJONALNE — Google Gemini. Bez klucza dziesiec tras /api/ai/* zwraca 503,
# a panele AI pokazuja komunikat o niedostepnosci funkcji.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2

# OPCJONALNE — poczta (Resend). Bez klucza kod jednorazowy jest wypisywany
# w konsoli serwera zamiast wysylany na adres uzytkownika.
RESEND_API_KEY=
EMAIL_FROM=Realty Nest <noreply@realtynest.com>
EMAIL_OVERRIDE_TO=

# OPCJONALNE — nazwa klienta dla geokodera Nominatim (wymog regulaminu uslugi).
GEOCODER_USER_AGENT=realty-nest-local
